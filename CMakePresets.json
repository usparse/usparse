{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "use-ninja",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "default-build-dir",
            "hidden": true,
            "binaryDir": "${sourceDir}/build"
        },

        {
            "name": "enable-benchmark",
            "hidden": true,
            "cacheVariables": {
                "BENCHMARK_FORCE_SYNC_KERNELS": "ON",
                "USPARSE_BUILD_BENCHMARK": "ON",
                "SPMV_OMP_ENABLED_FLAG": "ON"
            }
        },
        {
            "name": "use-platform-rocm",
            "hidden": true,
            "cacheVariables": {
                "UPSARSE_WAVEFRONT_SIZE": "64",
                "BENCHMARK_CUDA_ENABLE_FLAG": "OFF"
            }
        },
        {
            "name": "use-platform-cuda",
            "hidden": true,
            "cacheVariables": {
                "UPSARSE_WAVEFRONT_SIZE": "32",
                "BENCHMARK_CUDA_ENABLE_FLAG": "ON",
                // set cuda arch here.
                "HIP_NVCC_FLAGS": "-rdc=true -Xcompiler -fdiagnostics-color=always",
                "CMAKE_CUDA_ARCHITECTURES": "89",
                "HIP_NVCC_LINKER_FLAGS": "-rdc=true --generate-code=arch=compute_89,code=[compute_89,sm_89]"
                // "CMAKE_CUDA_SEPARABLE_COMPILATION": "ON",
                // "CMAKE_CUDA_RESOLVE_DEVICE_SYMBOLS": "ON"
            }
        },
        {
            "name": "use-nvcc-as-hipcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_C_COMPILER": "${sourceDir}/scripts/nvcc-as-hipcc.sh",
                "CMAKE_CXX_COMPILER": "${sourceDir}/scripts/nvcc-as-hipcc.sh",
                "CMAKE_CUDA_COMPILER": "${sourceDir}/scripts/nvcc-as-hipcc.sh",
                "USPARSE_LIB_COMPILE_OPTIONS": "-std=c++14"
            }
        },
        {
            "name": "use-nv-hipcc-wrapper",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_C_COMPILER": "${sourceDir}/scripts/hipcc-nv-wrapper.sh",
                "CMAKE_CXX_COMPILER": "${sourceDir}/scripts/hipcc-nv-wrapper.sh",
                "USPARSE_LIB_COMPILE_OPTIONS": "-std=c++14"
            }
        },
        {
            "name": "use-hipcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "hipcc",
                "CMAKE_CXX_COMPILER": "hipcc",
                "USPARSE_LIB_COMPILE_OPTIONS": "-std=c++14"
            }
        },
        {
            "name": "use-dcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "dcc",
                "CMAKE_CXX_COMPILER": "dcc",
                "CMAKE_C_FLAGS": "-Wno-return-type",
                "CMAKE_CXX_FLAGS": "-Wno-return-type",
                "USPARSE_LIB_COMPILE_OPTIONS": "-std=c++14 -Wno-return-type"
            }
        },

        {
            "name": "rocm-hipcc",
            "displayName": "Build for ROCm platform using hipcc without benchmark",
            "inherits": [
                "use-hipcc",
                "use-platform-rocm",
                "default-build-dir"
            ]
        },
        {
            "name": "rocm-dcc",
            "displayName": "Build for ROCm platform using dcc without benchmark",
            "inherits": [
                "use-dcc",
                "use-platform-rocm",
                "default-build-dir"
            ]
        },
        {
            "name": "cuda-hipcc",
            "displayName": "Build for CUDA platform using hipcc without benchmark",
            "inherits": [
                "use-nv-hipcc-wrapper",
                "use-platform-cuda",
                "default-build-dir"
            ]
        },
        {
            "name": "rocm-dcc-benchmark",
            "displayName": "Build for ROCm platform using dcc with benchmark enabled",
            "inherits": [
                "use-dcc",
                "enable-benchmark",
                "use-platform-rocm",
                "default-build-dir"
            ]
        },
        {
            "name": "rocm-hipcc-benchmark",
            "displayName": "Build for ROCm platform using hipcc with benchmark enabled",
            "inherits": [
                "use-hipcc",
                "enable-benchmark",
                "use-platform-rocm",
                "default-build-dir"
            ]
        },
        {
            "name": "cuda-nvcc-benchmark",
            "displayName": "Build for CUDA platform using nvcc with benchmark enabled",
            "inherits": [
                "use-nvcc-as-hipcc",
                "enable-benchmark",
                "use-platform-cuda",
                "default-build-dir"
            ]
        },
        {
            "name": "cuda-hipcc-benchmark",
            "displayName": "Build for CUDA platform using hipcc with benchmark enabled",
            "inherits": [
                "use-nv-hipcc-wrapper",
                "enable-benchmark",
                "use-platform-cuda",
                "default-build-dir"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "rocm-dcc",
            "configurePreset": "rocm-dcc"
        },
        {
            "name": "rocm-hipcc",
            "configurePreset": "rocm-hipcc"
        },
        {
            "name": "cuda-hipcc",
            "configurePreset": "cuda-hipcc"
        },

        {
            "name": "rocm-dcc-benchmark",
            "configurePreset": "rocm-dcc-benchmark"
        },
        {
            "name": "rocm-hipcc-benchmark",
            "configurePreset": "rocm-hipcc-benchmark"
        },
        {
            "name": "cuda-nvcc-benchmark",
            "configurePreset": "cuda-nvcc-benchmark"
        },
        {
            "name": "cuda-hipcc-benchmark",
            "configurePreset": "cuda-hipcc-benchmark"
        }
    ]
}
